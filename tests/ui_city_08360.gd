extends SceneTree
const LOD = preload("res://scripts/city_lod_08360.gd")
const Main = preload("res://scripts/main.gd")
const Chunk = preload("res://scripts/city_chunk_canvas_0870.gd")
const HUD = preload("res://scripts/android_hud_074.gd")
func _initialize() -> void:
    assert(LOD.stable(0.70, 1, 1) == 1)
    assert(LOD.stable(0.65, 1, 1) == 0)
    assert(LOD.stable(0.74, 1, 0) == 0)
    assert(LOD.stable(0.78, 1, 0) == 1)
    assert(LOD.stable(1.08, 2, 1) == 1)
    assert(LOD.stable(1.12, 2, 1) == 2)
    assert(LOD.stable(1.03, 2, 2) == 2)
    assert(LOD.stable(0.98, 2, 2) == 1)
    var game = Main.new()
    assert(game.stable_building_lod == 1)
    game.free()
    var chunk = Chunk.new()
    assert(chunk.draw_calls == 0)
    chunk.free()
    var hud = HUD.new()
    assert(not hud.settings_open)
    hud.free()
    print("UI_CITY_08360 PASS")
    quit(0)
