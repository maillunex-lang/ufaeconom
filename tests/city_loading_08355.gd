extends SceneTree
const Main = preload("res://scripts/main.gd")
func _initialize() -> void:
    var game = Main.new()
    var a: Dictionary = game._city_layout(0)
    assert(game.city_layout_misses == 1)
    var again: Dictionary = game._city_layout(0)
    assert(game.city_layout_hits == 1)
    assert(a == again)
    var b: Dictionary = game._city_layout(1)
    assert(a != b)
    game._city_layout(2)
    assert(game.city_layout_cache.size() == game.CITY_LAYOUT_CACHE_LIMIT)
    assert(not game.city_layout_cache.has(0))
    game._city_layout(1)
    assert(game.city_layout_hits == 2)
    game._city_layout(0)
    assert(game.city_layout_misses == 4)
    game._clear_city_layout_cache()
    assert(game.city_layout_cache.is_empty())
    assert(game.city_layout_order.is_empty())
    game.free()
    print("CITY_LOADING_08355 PASS")
    quit(0)
