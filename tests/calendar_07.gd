extends SceneTree
const Company = preload("res://scripts/company_state.gd")
const Calendar = preload("res://scripts/game_calendar.gd")
const Economy = preload("res://scripts/economy_simulator.gd")

func _initialize() -> void:
	assert(Calendar.REAL_SECONDS_PER_GAME_MONTH == 86400)
	assert(Calendar.REAL_SECONDS_PER_GAME_DAY == 2880)
	assert(Calendar.label(0) == "01.01.0001")
	assert(Calendar.label(29) == "30.01.0001")
	assert(Calendar.label(30) == "01.02.0001")
	assert(Calendar.label(359) == "30.12.0001")
	assert(Calendar.label(360) == "01.01.0002")
	assert(Calendar.due_days(10000, 12879) == 0)
	assert(Calendar.due_days(10000, 12880) == 1)
	assert(Calendar.due_days(10000, 10000 + 2880 * 200) == 90)
	assert(Calendar.due_days(10000, 9000) == 0)
	var c = Company.new()
	c.save_path = "user://calendar_07_test.json"
	c.legacy_save_path = "user://calendar_07_no_legacy.json"
	c.reset()
	var now := 1800000000
	assert(c.sync_calendar(now)["advanced"] == 0)
	assert(c.last_tick_unix == now)
	var base: int = Economy.monetary_total(c)
	assert(c.sync_calendar(now + 2879)["advanced"] == 0)
	assert(c.sync_calendar(now + 2880 * 4 + 10)["advanced"] == 4)
	assert(c.day == 4)
	assert(c.last_tick_unix == now + 2880 * 4)
	assert(c.sync_calendar(now + 2880 * 4 + 10)["advanced"] == 0)
	assert(c.load_game())
	assert(c.last_tick_unix == now + 2880 * 4)
	assert(c.sync_calendar(now + 2880 * 5)["advanced"] == 1)
	assert(c.day == 5)
	assert(Economy.monetary_total(c) == base)
	var bounded: Dictionary = c.sync_calendar(now + 2880 * 200)
	assert(bounded["advanced"] == 90)
	assert(bounded["pending"] == 105)
	assert(c.sync_calendar(now + 2880 * 200)["advanced"] == 90)
	assert(c.sync_calendar(now + 2880 * 200)["advanced"] == 15)
	assert(c.day == 200)
	assert(Economy.monetary_total(c) == base)
	var envelope: Dictionary = Calendar.simulation_command("bash-1", "player-1", 201, "cmd-1", "production.start", {"factory_id":"factory-1"})
	assert(envelope["tick"] == 201 and envelope["protocol_version"] == 1)
	print("CALENDAR_07_TESTS_PASSED 24h_month=1 offline=200days save=ok money=conserved")
	quit(0)
