extends SceneTree
const Main = preload("res://scripts/main.gd")
const Atmosphere = preload("res://scripts/city_atmosphere_25d.gd")
func _initialize() -> void:
    var city = Main.new()
    assert(city.CAMERA_MIN_ZOOM < city.CAMERA_MAX_ZOOM)
    assert(city.CAMERA_ZOOM_RESPONSE > 0.0)
    assert(city.has_method("_sync_chunk_canvases"))
    assert(city.has_method("_visible_tile_rect"))
    assert(city.has_method("_set_zoom_at"))
    var atmosphere = Atmosphere.new()
    assert(atmosphere.quality == 1)
    atmosphere.set_quality(0)
    assert(atmosphere.quality == 0)
    atmosphere.set_quality(5)
    assert(atmosphere.quality == 2)
    atmosphere.free()
    city.free()
    print("CITY_VISUAL_08351 PASS")
    quit(0)
