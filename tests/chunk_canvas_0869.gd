extends SceneTree
const Main = preload("res://scripts/main.gd")
const Chunk = preload("res://scripts/city_chunk_canvas_0870.gd")
const Background = preload("res://scripts/city_background_0870.gd")
func _initialize() -> void:
    var city = Main.new()
    var chunk = Chunk.new()
    chunk.configure(city, Vector2i(1, 2), 1, 0.8)
    assert(chunk.chunk == Vector2i(1, 2))
    assert(chunk.budget == 1)
    assert(chunk.z_index == -1)
    chunk.set_detail(0, 0.8)
    assert(chunk.budget == 0)
    chunk.set_detail(2, 1.0)
    assert(chunk.budget == 2)
    var bg = Background.new()
    city.static_chunk_nodes["1:2"] = chunk
    city._clear_chunk_canvases()
    assert(city.static_chunk_nodes.is_empty())
    assert(city.chunk_sync_requested)
    bg.free()
    city.free()
    print("CHUNK_CANVAS_0869 PASS")
    quit(0)