extends SceneTree
const Main = preload("res://scripts/main.gd")
func _initialize() -> void:
    var game = Main.new()
    var tile := Vector2i(5, 6)
    var first: Dictionary = game._static_tile_data(tile)
    assert(game.terrain_cache_misses == 1)
    assert(game.terrain_cache_hits == 0)
    var second: Dictionary = game._static_tile_data(tile)
    assert(first == second)
    assert(game.terrain_cache_misses == 1)
    assert(game.terrain_cache_hits == 1)
    assert(first.has("kind") and first.has("tint") and first.has("ore"))
    game._clear_terrain_cache()
    assert(game.terrain_cache.is_empty())
    assert(game.terrain_cache_hits == 0)
    game.free()
    print("CITY_TERRAIN_CACHE_0867 PASS")
    quit(0)