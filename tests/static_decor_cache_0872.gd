extends SceneTree
const Chunk = preload("res://scripts/city_chunk_canvas_0870.gd")
const Main = preload("res://scripts/main.gd")
func _initialize() -> void:
    var city = Main.new()
    var node = Chunk.new()
    node.configure(city, Vector2i(0, 0), 0, 0.6)
    assert(node.budget == 0)
    node.set_detail(1, 0.8)
    assert(node.budget == 1)
    node.set_detail(2, 1.2)
    assert(node.budget == 2)
    assert(node.has_method("_draw_tree"))
    assert(node.has_method("_draw_road"))
    assert(not city.has_method("_draw_tree"))
    assert(not city.has_method("_draw_road"))
    node.free()
    city.free()
    print("STATIC_DECOR_CACHE_0872 PASS")
    quit(0)