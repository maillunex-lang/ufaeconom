extends SceneTree
const Policy = preload("res://scripts/adaptive_chunk_budget_08358.gd")
const Main = preload("res://scripts/main.gd")
func _initialize() -> void:
    assert(Policy.capacity(60.0, 2) == 2)
    assert(Policy.capacity(35.0, 2) == 1)
    assert(Policy.capacity(20.0, 2) == 0)
    assert(Policy.capacity(42.0, 0) == 1)
    assert(Policy.capacity(47.0, 1) == 1)
    assert(Policy.capacity(52.0, 1) == 2)
    assert(Policy.capacity(0.0, 2) == 0)
    assert(Policy.frame_budget(35.0, 1, 0) == 1)
    assert(Policy.frame_budget(35.0, 1, 1) == 0)
    assert(Policy.frame_budget(60.0, 2, 1) == 2)
    var game = Main.new()
    assert(game.CHUNKS_PER_FRAME == 2)
    assert(game.adaptive_chunk_capacity == 2)
    game.free()
    print("ADAPTIVE_CHUNK_BUDGET_08358 PASS")
    quit(0)
